[CONTROLS]
LINK PU1 1 IF NODE T1 BELOW 3.5
LINK PU1 0 IF NODE T1 ABOVE 5.2

[SCRIPT]
-- Remote-control PRV: hold a target pressure at a 
-- control node anywhere downstream of the valve, by
-- shifting the valve setting by the pressure error
-- seen at that node.

-- === user settings ==============================
local valve_id    = "V1"     -- PRV under control
local junction_id = "J126"   -- regulating junction
local set_point   = 25.0     -- target pressure 
-- ================================================
 
function remotePrv(valveId, nodeId, setting) 
    local diff = node(nodeId).pressure - setting
    if math.abs(diff) > 0.01 then
        link(valveId).setting = link(valveId).setting - diff
    end    
end

remotePrv(valve_id, junction_id, set_point)

[END]